{
  "name": "mizien-site",
  "private": true,
  "description": "Static site for Miżien: built from claims/*/claim.yml with Eleventy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data": "python3 scripts/validate_claims.py && python3 scripts/build_site_data.py",
    "build": "npm run data && eleventy",
    "serve": "npm run data && eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "markdown-it": "14.3.2"
  }
}
