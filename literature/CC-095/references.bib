@misc{rapa_2025,
  author       = {Rapa, Noel},
  title        = {Energy Subsidies in Malta: Estimating the Effects of Current Policies and Hypothetical Exit Strategies},
  year         = {2025},
  howpublished = {SSRN posted content},
  doi          = {10.2139/ssrn.5353671},
  note         = {Not peer-reviewed. Crossref checked and abstract read 10 Oct 2026; full text not read (SSRN 403; centralbankmalta.org 403). Structural model MEDSEA-NRG: the fixed-price policy supported activity, reduced inflation and protected low-income households in 2022-23; raised the debt ratio by about 4 points by 2024; sudden removal would cause a contraction, gradual tapering or recycling less. Grade C.}
}
