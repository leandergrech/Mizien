@article{grunzweig2007,
  author  = {Gr{\"u}nzweig, J. M. and Gelfand, I. and Fried, Y. and Yakir, D.},
  title   = {Biogeochemical factors contributing to enhanced carbon storage following afforestation of a semi-arid shrubland},
  journal = {Biogeosciences},
  volume  = {4},
  number  = {5},
  pages   = {891--904},
  year    = {2007},
  doi     = {10.5194/bg-4-891-2007},
  note    = {F. Open access (CC BY-NC-SA 2.5); PDF in literature/CC-107/open-access/. Ecosystem C 2380 to 5840 g C m-2 after 35 years (99 g C m-2 yr-1; soil 50); 300 trees per ha, not irrigated or fertilised (p. 892). Grade B (chronosequence with a shrubland control).}
}

@article{renna2024,
  author  = {Renna, Valeria and Mart{\'i}n-Gallego, Pilar and Juli{\'a}n, Federico and Six, Johan and Cardinael, R{\'e}mi and Laub, Moritz},
  title   = {Initial soil carbon losses may offset decades of biomass carbon accumulation in Mediterranean afforestation},
  journal = {Geoderma Regional},
  volume  = {36},
  pages   = {e00768},
  year    = {2024},
  doi     = {10.1016/j.geodrs.2024.e00768},
  note    = {A (abstract via Crossref/OpenAlex). Open access (CC BY 4.0, Elsevier); the PDF returned 403 to scripts, so not committed. Native Quercus ilex and Q. suber on former cropland, Extremadura: biomass 25-75 g C m-2 yr-1; soil C not significantly different from controls; total C not significantly higher. Grade B (afforested vs non-afforested plots).}
}

@article{bernal2018,
  author  = {Bernal, Blanca and Murray, Lara T. and Pearson, Timothy R. H.},
  title   = {Global carbon dioxide removal rates from forest landscape restoration activities},
  journal = {Carbon Balance and Management},
  volume  = {13},
  number  = {1},
  pages   = {22},
  year    = {2018},
  doi     = {10.1186/s13021-018-0110-8},
  note    = {F (Europe PMC full text, PMC6246754). CC BY 4.0; publisher and PMC PDFs refused scripts, so not committed. Table 1: planted forests, temperate dry, 0-20 years: oak 5.3, pine 7.6, other conifers 6.4 t CO2 ha-1 yr-1 (biomass above and below ground; soil excluded). Grade C (literature synthesis).}
}

@article{hoogmoed2012,
  author  = {Hoogmoed, M. and Cunningham, S. C. and Thomson, J. R. and Baker, P. J. and Beringer, J. and Cavagnaro, T. R.},
  title   = {Does afforestation of pastures increase sequestration of soil carbon in {Mediterranean} climates?},
  journal = {Agriculture, Ecosystems \& Environment},
  volume  = {159},
  pages   = {176--183},
  year    = {2012},
  doi     = {10.1016/j.agee.2012.07.011},
  note    = {A (Europe PMC abstract). Bayesian meta-analysis: no evidence of substantial change in soil carbon across three decades of afforestation of pastures in a Mediterranean climate. Grade C.}
}

@article{maestre2004,
  author  = {Maestre, Fernando T. and Cortina, Jordi},
  title   = {Are {Pinus halepensis} plantations useful as a restoration tool in semiarid {Mediterranean} areas?},
  journal = {Forest Ecology and Management},
  volume  = {198},
  number  = {1--3},
  pages   = {303--317},
  year    = {2004},
  doi     = {10.1016/j.foreco.2004.05.040},
  note    = {A (Europe PMC abstract). Review: plantations often show more runoff and soil loss than natural shrubland, limited soil improvement after 40 years, higher water use, and mostly negative effects on spontaneous vegetation. Grade C.}
}

@article{oliet2023,
  author  = {Oliet, Juan A. and Planelles, Rosa and Artero, Francisco and Jacobs, Douglass F.},
  title   = {Mesh-shelters provide more effective long-term protection than tube-shelters or mulching for restoration of {Pinus halepensis} in a {Mediterranean} arid ecosystem},
  journal = {Frontiers in Forests and Global Change},
  volume  = {5},
  pages   = {1092703},
  year    = {2023},
  doi     = {10.3389/ffgc.2022.1092703},
  note    = {A, PDF committed (CC BY 4.0) in open-access/. 20-year survival 57.5% (mesh shelters), 46% (no shelter), 29.5% (tube shelters), arid south-eastern Spain; mortality did not stabilise until 15 years. Grade A (field experiment). Also cited in Claim Check 010.}
}

@article{jackson2005,
  author  = {Jackson, Robert B. and Jobb{\'a}gy, Esteban G. and Avissar, Roni and Roy, Somnath Baidya and Barrett, Damian J. and Cook, Charles W. and Farley, Kathleen A. and le Maitre, David C. and McCarl, Bruce A. and Murray, Brian C.},
  title   = {Trading water for carbon with biological carbon sequestration},
  journal = {Science},
  volume  = {310},
  number  = {5756},
  pages   = {1944--1947},
  year    = {2005},
  doi     = {10.1126/science.1119282},
  note    = {A. Plantations decreased stream flow by 227 mm a year globally (52%); 13% of streams dried completely for at least a year. Grade C (synthesis of more than 600 observations with modelling).}
}

@article{rotenberg2010,
  author  = {Rotenberg, Eyal and Yakir, Dan},
  title   = {Contribution of semi-arid forests to the climate system},
  journal = {Science},
  volume  = {327},
  number  = {5964},
  pages   = {451--454},
  year    = {2010},
  doi     = {10.1126/science.1179998},
  note    = {A. Nine-year study at the dry timberline (Yatir): substantial carbon sequestration maintained where rainfall is 200-600 mm, but several decades of carbon accumulation are needed to balance the warming from lower albedo and suppressed longwave emission. Grade B.}
}

@article{yosef2018,
  author  = {Yosef, Gil and Walko, Robert and Avisar, Roni and Tatarinov, Fedor and Rotenberg, Eyal and Yakir, Dan},
  title   = {Large-scale semi-arid afforestation can enhance precipitation and carbon sequestration potential},
