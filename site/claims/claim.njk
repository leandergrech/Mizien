---
layout: base.njk
pagination:
  data: mizien.claims
  size: 1
  alias: claim
permalink: "/claims/{{ claim.id }}/"
styles: [lens.css]
---
{%- import "macros.njk" as m -%}
{%- set c = claim -%}
{%- set cn = c.connections -%}
{%- set verdictInfo = mizien.verdicts | findBy("name", c.verdict) -%}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol><li><a href="/">Home</a></li><li><a href="/claims/">Claims</a></li><li aria-current="page">{{ c.id }}</li></ol>
</nav>

{%- set pv = c.pledge_view -%}
<article class="check v-{{ c.label_slug or 'none' }}">
  <header class="check-head">
    <p class="kicker">{{ c.id }} · {% glyph c.category %}{{ c.category }}{% if c.subtopic %} · {% glyph c.subtopic %}{{ c.subtopic }}{% endif %}</p>
    <h1>{{ c.title }}</h1>
    <p class="verdictline">
      {%- if c.verdict or not pv %}
      {%- set vname = c.verdict or "Not yet checked" %}<span class="verdict">{% glyph vname %}{{ vname }}</span>
      {%- if c.verdict_confidence %} <span class="pill">{{ c.verdict_confidence }} confidence</span>{% endif %}
      {%- endif %}
      {%- if pv %}
      <span class="{{ 'verdict' if pv.pure else 'pill pledge-pill' }}"{% if not pv.pure %} style="--pl: {{ pv.colour }}; --pl-ink: {{ pv.ink }}"{% endif %}>{% set pglyph = "pledge:" + pv.status %}{% glyph pglyph %}Pledge: {{ pv.status }}</span>
      <span class="pill">as of {{ pv.as_of }}</span>
      {%- endif %}
      <span class="pill">{{ c.status_label }}</span>
    </p>
    {%- if c.files.length %}
    <ul class="head-downloads" aria-label="Download">
      {%- for f in c.files %}
      <li><a class="dl-chip" href="{{ f.url }}" download="{{ c.id }}-{{ f.name }}">{% icon "download" %}{{ f.label }}<span>{{ f.type }}{% if f.bytes %} · {{ f.bytes | fileSize }}{% endif %}</span></a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    <div class="claim-pin" id="claim-pin" data-id="{{ c.id }}" hidden>
      <button type="button" class="cp-btn" aria-pressed="false">Pin this claim</button>
    </div>
  </header>

  <div class="check-body{% if c.report_html %} has-report{% endif %}">
    <nav class="page-tabs" aria-label="On this page">
      {%- if pv %}<a href="#h-pledge">{% icon "flag" %}<span>Pledge</span></a>{% endif %}
      {%- if c.subclaims and c.subclaims.length %}<a href="#h-parts">{% icon "parts" %}<span>Parts</span></a>{% endif %}
      {%- if c.report_html %}<a href="#report">{% icon "report" %}<span>Report</span></a>{% else %}<a href="#h-claim">{% icon "report" %}<span>The claim</span></a>{% endif %}
      <a href="#h-sources">{% icon "sources" %}<span>Sources</span></a>
      <a href="#h-reply">{% icon "reply" %}<span>Right of reply</span></a>
      <a href="#h-links">{% icon "links" %}<span>Connections</span></a>
      <a href="#h-time">{% icon "clock" %}<span>Timeline</span></a>
      {%- if c.files.length %}<a href="#h-downloads">{% icon "download" %}<span>Downloads</span></a>{% endif %}
    </nav>
    {%- for x in c.corrections | reverse %}
    <aside class="notice is-correction" aria-label="{{ 'Corrected' if x.step == 'version' else x.label }}">
      {%- if x.step == "version" %}
      <p><strong>Corrected, {{ x.date }}.</strong> Version {{ x.version }} of this check corrects errors in the version
        before it. What was wrong and what changed is in the <a href="#h-time">timeline</a> below and on the
        <a href="/corrections/">Corrections page</a>.</p>
      {%- else %}
      <p><strong>{{ x.label }}, {{ x.date }}.</strong> {{ x.text }} <a href="/corrections/">All corrections and changes</a>.</p>
      {%- endif %}
    </aside>
    {%- endfor %}
    {%- if c.is_draft and c.label %}
    <aside class="notice" aria-label="Draft notice">
      {%- if c.reply == "not-needed" %}
      <p><strong>This is a draft check.</strong> It finds the claim supported, so no right of reply is needed. The verdict
         may change in light of new evidence. A verdict applies to the statement as worded on the date it was made; it is
         not a judgement of anyone's motives. <a href="/about/disclaimer/">What a check represents</a>.</p>
      {%- elif c.reply == "on-hold" %}
      <p><strong>This is a draft check.</strong> The right of reply is on hold {{ c.right_of_reply.on_hold }}, and the
         verdict may change once that is done or in light of new evidence. A verdict applies to the statement as worded
         on the date it was made; it is not a judgement of anyone's motives. <a href="/about/disclaimer/">What a check represents</a>.</p>
      {%- elif c.reply == "not-sought" %}
      <p><strong>This is a draft check.</strong> A right of reply was not sought for it, at the maintainer's direction.
         The verdict may change in light of new evidence. A verdict applies to the statement as worded on the date it
         was made; it is not a judgement of anyone's motives. <a href="/about/disclaimer/">What a check represents</a>.</p>
      {%- else %}
      <p><strong>This is a draft check.</strong> The body concerned has not yet had the chance to reply, and the verdict
         may change in light of its response or new evidence. A verdict applies to the statement as worded on the date
         it was made; it is not a judgement of anyone's motives. <a href="/about/disclaimer/">What a check represents</a>.</p>
      {%- endif %}
    </aside>
    {%- endif %}

    {%- if pv %}
    {%- set plabel = mizien.pledge_labels | findBy("name", pv.status) %}
    <section class="pledge-box" aria-labelledby="h-pledge" style="--pl: {{ pv.colour }}; --pl-ink: {{ pv.ink }}">
      <h2 id="h-pledge">{% icon "flag" %}The pledge{% if not pv.pure %} in this claim{% endif %}</h2>
      <p class="pledge-status"><span class="pledge-label">{{ pv.status }}</span> <span class="small">as of {{ pv.as_of }}</span></p>
      {%- if plabel %}<p class="small">{{ pv.status }}: {{ plabel.meaning | mdInline | safe }}</p>{% endif %}
      {%- if pv.note %}<p>{{ pv.note }}</p>{% endif %}
      {%- if not pv.pure %}<p class="small">A pledge gets a label, not a verdict. The verdict above ({{ c.verdict }}) is for the factual part of the claim.</p>{% endif %}
      <dl class="facts">
        <div><dt>Target</dt><dd>{{ pv.target }}</dd></div>
        <div><dt>Made by</dt><dd>{% for b in pv.made_by %}{{ m.body(b) }}{% if not loop.last %} {% endif %}{% endfor %}</dd></div>
        <div><dt>Made in</dt><dd>{{ pv.vehicle }}{% if pv.made_on %} ({{ pv.made_on }}){% endif %}</dd></div>
        <div><dt>Deadline</dt><dd>{{ pv.deadline or "none stated" }}</dd></div>
        {%- if pv.term_end %}<div><dt>Term ended</dt><dd>{{ pv.term_end }}</dd></div>{% endif %}
      </dl>
      <p class="small"><a href="/pledges/">All pledges and how they are labelled</a> · <a href="/explore/?group=pledges&amp;sel=claim:{{ c.id }}">See it on the pledge disks</a></p>
    </section>
    {%- endif %}

    {%- if c.subclaims and c.subclaims.length %}
    <section class="parts" aria-labelledby="h-parts">
      <h2 id="h-parts">{% icon "parts" %}Parts of this claim</h2>
      <p class="small">The claim is split into parts that are tested separately{% if c.report_html %}, as in the report below{% endif %}. Each part has its own number.</p>
      <ol class="part-list">
        {%- for x in c.subclaims %}
        <li id="{{ x.id }}" class="part tone-{{ x.tone or 'grey' }}">
          <dfn class="part-id">{{ x.id }}</dfn>
          <span class="part-body"><span class="part-text">{{ x.text }}</span>{% if x.said_by %} <span class="small">({{ x.said_by }})</span>{% endif %}
            {%- if x.finding %}<span class="part-finding">{{ x.finding }}</span>{% endif %}</span>
          {%- if x.rating %}<span class="part-rating">{{ x.rating }}</span>{% endif %}
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}

    {%- if c.report_html %}
    <section class="report-wrap" id="report" aria-label="Full report">
      {{ c.report_html | safe }}
    </section>
    {%- else %}
    <section aria-labelledby="h-claim">
      <h2 id="h-claim">The claim</h2>
      {%- if c.claim.quote %}
      <blockquote><p>“{{ c.claim.quote }}”</p></blockquote>
      {%- endif %}
      <p>{{ c.claim.text }}</p>
      <dl class="facts">
        <div><dt>Who</dt><dd>{{ c.claim.speaker }}</dd></div>
        {%- if c.location and c.location.place %}<div><dt>Where</dt><dd>{% set plglyph = "place:" + (c.location.icon or "pin") %}{% glyph plglyph %}{{ c.location.place }}</dd></div>{% endif %}
        {%- if c.claim.date %}<div><dt>When</dt><dd>{{ c.claim.date | ukDate }}</dd></div>{% endif %}
        <div><dt>Wording</dt><dd>{{ c.claim.wording_status }}</dd></div>
      </dl>
    </section>

    {%- if c.verdict %}
    <section aria-labelledby="h-verdict">
      <h2 id="h-verdict">Verdict</h2>
      <p><strong>{{ c.verdict }}</strong>{% if c.verdict_confidence %}, {{ c.verdict_confidence | lower }} confidence{% endif %}.
         {%- if verdictInfo %} <span class="def">{{ c.verdict }}: {{ verdictInfo.meaning }}</span>{% endif %}</p>
      <p class="small"><a href="/methodology/how-a-verdict-is-reached/">How a verdict is reached</a> ·
         <a href="/about/disclaimer/">What a check represents</a></p>
    </section>
    {%- endif %}

    {%- if c.counter_evidence %}
    <section aria-labelledby="h-evidence">
      <h2 id="h-evidence">{% if c.verdict %}What the evidence shows{% else %}Context{% endif %}</h2>
      <p>{{ c.counter_evidence }}</p>
    </section>
    {%- endif %}

    {%- if c.evidence_shown and c.evidence_shown.length %}
    <section aria-labelledby="h-shown">
      <h2 id="h-shown">Documents and data the verdict rests on</h2>
      <ul>{% for e in c.evidence_shown %}<li>{{ e }}</li>{% endfor %}</ul>
    </section>
    {%- endif %}

    {%- if c.limitations %}
    <section aria-labelledby="h-limits">
      <h2 id="h-limits">Limitations</h2>
      <p>{{ c.limitations }}</p>
    </section>
    {%- endif %}

    {%- if c.tests %}
    <section aria-labelledby="h-tests">
      <h2 id="h-tests">{% if c.verdict %}Tested against{% else %}What it will be tested against{% endif %}</h2>
      <p>{{ c.tests }}</p>
    </section>
    {%- endif %}
    {%- endif %}

    <section aria-labelledby="h-sources">
      <h2 id="h-sources">{% if c.report_html %}Sources and archived copies{% else %}Sources{% endif %}</h2>
      {%- if c.sources.length %}
      <ol class="sources">
        {%- for s in c.sources %}
        <li>
          <cite>{{ s.title }}</cite>{% if s.publisher %}, {{ s.publisher }}{% endif %}{% if s.date %}, {{ s.date }}{% endif %}.
          <span class="links">
            {%- if s.archive.state == "offline" %} No public link ({{ s.url }}).
            {%- else %} <a href="{{ s.url }}" rel="nofollow">Original</a>
              {%- if s.archive.url %} · <a href="{{ s.archive.url }}" rel="nofollow">Archived copy</a>
              {%- elif s.archive.state == "hashed" %} · <span class="small">fetched and fingerprinted {{ s.archive.retrieved_utc | truncate(10, true, "") }}; no public snapshot yet</span>
              {%- else %} · <span class="small">not yet archived</span>{% endif %}
            {%- endif %}
          </span>
          {%- if s.note %}<br><span class="small">{{ s.note }}</span>{% endif %}
        </li>
        {%- endfor %}
      </ol>
      {%- else %}
      <p>No sources recorded yet.</p>
      {%- endif %}
    </section>

    <section aria-labelledby="h-reply">
      <h2 id="h-reply">Right of reply</h2>
      {%- set ror = c.right_of_reply or {} %}
      {%- if ror.response %}
      <p>{{ ror.response }}</p>
      {%- elif c.reply == "not-needed" %}
      <p>Not needed: this check finds the claim supported. A right of reply is sought when a check finds a claim Not
         substantiated, Misleading or Contradicted{% if c.pledge_view %} (for a pledge: Not measurable, Off track or Missed){% endif %}.</p>
      {%- elif c.reply == "not-sought" %}
      <p>{{ ror.note or "Not sought, at the maintainer's direction." }}</p>
      {%- elif c.reply == "on-hold" %}
      <p>On hold {{ ror.on_hold }}: the reply would rest on a document we have not yet read. Once it is read, a draft
         will go to the body concerned with a deadline, and its response will be published here.</p>
      {%- elif ror.sent %}
      <p>A draft was sent to the body concerned on {{ ror.sent | ukDate }}{% if ror.deadline %}, with a deadline of {{ ror.deadline | ukDate }}{% endif %}. Its response will be published here.</p>
      {%- elif c.verdict %}
      <p>The body concerned has not yet been asked to reply. Its response will be published here, beside the verdict.</p>
      {%- else %}
      <p>Not applicable until a draft verdict exists.</p>
      {%- endif %}
    </section>

    <section class="connections" aria-labelledby="h-links">
      <h2 id="h-links">Connections</h2>
      <p class="conn-intro">How this claim relates to the others: who made it, the themes it shares with other claims,
        and the patterns it shows. A connection is a reason to read two checks side by side. It does not make either one
        right or wrong. <a href="/methodology/connections/">How connections are found</a>.</p>

      <div class="conn-block">
        <h3>{% icon "people" %}Who made it</h3>
        <p class="conn-bodies">{% for b in c.bodies %}{{ m.body(b) }}{% if b.kind == "person" and b.parent %}<span class="small"> for {{ m.body(b.parent) }}</span>{% endif %}{% if not loop.last %} {% endif %}{% endfor %}</p>
        {%- for g in cn.same_body %}
        <p class="conn-lead">Other claims by <a href="{{ g.body.path }}">{{ g.body.name }}</a> <span class="count">{{ g.claims.length }}</span></p>
        <ul class="cref-list">{% for x in g.claims %}<li>{{ m.claim(x) }}</li>{% endfor %}</ul>
        {%- else %}
        <p class="small">No other claim by {% if c.bodies.length > 1 %}these bodies{% else %}this body{% endif %} is listed yet.</p>
        {%- endfor %}
      </div>

      <div class="conn-block">
        <h3>{% icon "links" %}Linked directly <span class="count">{{ c.links.length }}</span></h3>
        {%- if c.links.length %}
        <p class="conn-lead">Claims that share a theme with this one. A theme is a cause, a mechanism, a target or a way of
          presenting figures that the editors have found in several claims; its strength says how close the link is.</p>
        {%- for tid, items in c.links | groupby("theme_id") %}
        {%- set th = mizien.themes | findBy("id", tid) %}
        <div class="theme-card" style="--t: {{ th.color if th else '#7fa88b' }}">
          <p class="theme-name">{{ th.name if th else tid }} <span class="theme-kind">{{ items[0].link_type }} · {{ items[0].strength }}</span></p>
          {%- if th and th.description %}<p class="theme-desc">{{ th.description }}</p>{% endif %}
          <ul class="cref-list">{% for l in items %}{% set x = mizien.claims | findBy("id", l.id) %}<li>{{ m.claim(x) }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
        {%- else %}
        <p class="small">Not yet linked to another claim by a theme.</p>
        {%- endif %}
      </div>

      {%- if cn.patterns.length %}
      <div class="conn-block">
        <h3>{% icon "pattern" %}Same pattern</h3>
        <p class="conn-lead">Pattern tags name a recurring way a claim can mislead. They describe the statement, not the
          speaker{% if c.tags_provisional %}, and this claim's tags are provisional until its report is finished{% endif %}.</p>
        {%- for t in cn.patterns %}
        <div class="theme-card is-pattern">
          <p class="theme-name">{{ t.tag }}</p>
          {%- if t.meaning %}<p class="theme-desc">{{ t.meaning | mdInline | safe }}</p>{% endif %}
          {%- if t.claims.length %}
          <ul class="cref-list">{% for x in t.claims %}<li>{{ m.claim(x) }}</li>{% endfor %}</ul>
          {%- else %}<p class="small">No other claim carries this tag yet.</p>{% endif %}
        </div>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if cn.second.length %}
      <div class="conn-block">
        <h3>{% icon "route" %}Two steps away <span class="count">{{ cn.second.length }}</span></h3>
        <p class="conn-lead">Not linked to this claim directly, but linked to a claim that is. These are found by following
          the links, not chosen by the editors, so they are looser: they show where one theme meets another.</p>
        <ul class="cref-list is-routes">
          {%- for x in cn.second %}
          <li>{{ m.claim(x) }}<span class="via">through {% for p in x.via %}{{ m.route(p, mizien.themes) }}{% if not loop.last %} or {% endif %}{% endfor %}</span></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}

      {%- if cn.third.length %}
      <details class="conn-block conn-more">
        <summary><span class="h3">{% icon "route" %}Three steps away <span class="count">{{ cn.third.length }}</span></span></summary>
        <p class="conn-lead">One step further again. At this distance a connection says more about how the themes fit
          together than about this claim.</p>
        <ul class="cref-list is-routes">
          {%- for x in cn.third %}
          <li>{{ m.claim(x) }}<span class="via">through {{ m.route(x.via[0], mizien.themes) }}</span></li>
          {%- endfor %}
        </ul>
      </details>
      {%- endif %}
      {%- if c.similar and c.similar.length %}
      <div class="conn-block">
        <h3>{% icon "pattern" %}Similar wording</h3>
        <p class="small">Claims whose own words overlap with this one, with the words they share. Found by comparing the
          wording of the claims, not their verdicts; a lead to read them together, not a finding.</p>
        <ul class="cref-list">{% for x in c.similar %}<li>{{ m.claim(x) }}<span class="via">shares: {{ x.terms | join(", ") }}</span></li>{% endfor %}</ul>
      </div>
      {%- endif %}
    </section>

    <section class="timeline-sec" aria-labelledby="h-time">
      <h2 id="h-time">Timeline</h2>
      <p class="conn-intro">What was said, what was published before and after it, and each step of this check, in date
        order. Statements and sources carry the date they were published. The steps of the check carry the date the
        research was done, from the check's research log. Other statements by the same body on the same topic show
        whether a position was repeated, changed or corrected.</p>
      {%- if not c.claim.date %}<p class="small">The date of the statement is not recorded yet.</p>{% endif %}
      {%- if c.timeline.length %}
      <ol class="tl">
        {%- for y, evs in c.timeline | groupby("year") %}
        <li class="tl-year"><h3>{{ y }}</h3>
          <ol>
            {%- for e in evs %}
            <li class="tl-ev k-{{ e.kind }}{% if e.future %} is-future{% endif %}{% if e.self %} is-self{% endif %}">
              <span class="tl-date">{{ e.date }}</span>
              <span class="tl-what"><span class="tl-kind">{% if e.future %}Coming up: {% endif %}{{ e.label }}</span>
              {%- if e.claim %} {{ m.claim(e.claim) }}
              {%- elif e.self %} <span class="tl-text">{{ c.claim.speaker }} (this claim)</span>
              {%- elif e.kind == "check" or e.kind == "correction" %}{% if e.text %} <span class="tl-text">{{ e.text }}</span>{% endif %}{% if e.verdict %} <span class="tl-verdict">Verdict in this version: {{ e.verdict }}.</span>{% endif %}{% if e.kind == "correction" %} <a class="tl-change" href="/corrections/">all corrections</a>{% endif %}
              {%- elif e.text %} <span class="tl-text">{% if e.url %}<a href="{{ e.url }}" rel="nofollow">{{ e.text }}</a>{% else %}{{ e.text }}{% endif %}{% if e.by %}, {{ e.by }}{% endif %}</span>
              {%- endif %}</span>
            </li>
            {%- endfor %}
          </ol>
        </li>
        {%- endfor %}
      </ol>
      {%- endif %}
      <p class="small">Every change to this claim's record is public: <a href="{{ site.repo }}/commits/main/claims/{{ c.id }}/claim.yml" rel="nofollow">history of the record</a>.</p>
    </section>

    {%- if c.files.length %}
    <section class="downloads" aria-labelledby="h-downloads">
      <h2 id="h-downloads">Download the report and flyer</h2>
      <div class="download-grid">
        {%- set flyer = c.files | findBy("key", "flyer_png") %}
        {%- if c.flyer_preview and flyer %}
        <a class="flyer-preview" href="{{ flyer.url }}" title="Open the full-size flyer image">
          <img src="{{ c.flyer_preview.url }}" width="{{ c.flyer_preview.width }}" height="{{ c.flyer_preview.height }}"
               alt="Flyer for {{ c.id }}: {{ c.title }}" loading="lazy">
        </a>
        {%- endif %}
        <ul class="download-buttons">
          {%- for f in c.files %}
          <li><a class="btn-download" href="{{ f.url }}" download="{{ c.id }}-{{ f.name }}">
            <span class="dl-label">{% icon "download" %}{{ f.label }}</span>
            <span class="dl-meta">{{ f.type }}{% if f.bytes %} · {{ f.bytes | fileSize }}{% endif %}</span></a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>
    {%- endif %}

    <footer class="check-meta">
      <dl class="facts">
        {%- if c.version %}<div><dt>Version</dt><dd>{{ c.version }}</dd></div>{% endif %}
        {%- if c.last_reviewed %}<div><dt>Evidence last reviewed</dt><dd>{{ c.last_reviewed | ukDate }}</dd></div>{% endif %}
        {%- if c.tags.length %}
        <div><dt>Pattern{% if c.tags.length > 1 %}s{% endif %}{% if c.tags_provisional %} (provisional){% endif %}</dt>
          <dd>{% for t in c.tags %}{% set p = mizien.patterns | findBy("name", t) %}<span title="{{ p.meaning if p }}">{{ t }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
        {%- endif %}
      </dl>
      <p class="small">
        <a href="{{ c.record_url }}">Claim record (claim.yml)</a> ·
        <a href="{{ site.repo }}/issues/new?template=contest-verdict.yml&amp;title=%5BCorrection%5D%20{{ c.id }}">Report an error or contest this check</a>
      </p>
    </footer>
  </div>
</article>

{%- if pager %}
<nav class="pager" aria-label="All claims, by number">
  {%- if pager.prev %}<a class="pager-step" href="{{ pager.prev.path }}">{% icon "prev" %}<span>Previous</span></a>
  {%- else %}<span class="pager-step is-off">{% icon "prev" %}<span>Previous</span></span>{% endif %}
  <ol>
    {%- for p in pager.pages %}
    {%- if p.gap %}<li class="pager-gap" aria-hidden="true">…</li>
    {%- else %}<li><a class="pg v-{{ p.verdict_slug or 'none' }}{% if p.current %} is-current{% endif %}" href="{{ p.path }}" aria-label="{{ p.id }}: {{ p.title }}"{% if p.current %} aria-current="page"{% endif %}>{{ p.n }}</a></li>{% endif %}
    {%- endfor %}
  </ol>
  {%- if pager.next %}<a class="pager-step" href="{{ pager.next.path }}"><span>Next</span>{% icon "next" %}</a>
  {%- else %}<span class="pager-step is-off"><span>Next</span>{% icon "next" %}</span>{% endif %}
  <p class="pager-count">Claim {{ pager.index }} of {{ pager.total }} · the dot under each number is its verdict colour<span class="pager-keys"> · ← → keys also work</span></p>
</nav>

<nav class="claim-flip" aria-label="Previous and next claim">
  {%- if pager.prev %}
  <a class="flip flip-prev" href="{{ pager.prev.path }}" aria-label="Previous claim: {{ pager.prev.id }}, {{ pager.prev.title }}">{% icon "prev" %}<span class="flip-label"><b>{{ pager.prev.id }}</b> <span>{{ pager.prev.title }}</span></span></a>
  {%- endif %}
  {%- if pager.next %}
  <a class="flip flip-next" href="{{ pager.next.path }}" aria-label="Next claim: {{ pager.next.id }}, {{ pager.next.title }}"><span class="flip-label"><b>{{ pager.next.id }}</b> <span>{{ pager.next.title }}</span></span>{% icon "next" %}</a>
  {%- endif %}
</nav>
<script>
  // ← and → move between claims (not while typing, and not with modifier keys).
  (function () {
    var prev = document.querySelector(".claim-flip .flip-prev"), next = document.querySelector(".claim-flip .flip-next");
    document.addEventListener("keydown", function (e) {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || e.defaultPrevented) return;
      var t = e.target;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (e.key === "ArrowLeft" && prev) location.href = prev.href;
      if (e.key === "ArrowRight" && next) location.href = next.href;
    });
  })();
</script>
{%- endif %}
<script src="/assets/tray.js" defer></script>
<script>
  // Pin this claim to the tray (assets/tray.js) shared with Explore and the timeline; the tray's button sits beside it.
  addEventListener("DOMContentLoaded", function () {
    var box = document.getElementById("claim-pin"), T = window.MizienTray; if (!box || !T) return;
    var id = box.dataset.id, b = box.querySelector(".cp-btn");
    function sync() { var on = T.has(id); b.setAttribute("aria-pressed", on ? "true" : "false"); b.textContent = on ? "Pinned · unpin" : "Pin this claim"; }
    b.addEventListener("click", function () { T.toggle(id); });
    T.init({ mount: box, url: false, onChange: sync });
    box.hidden = false; sync();
  });
</script>
