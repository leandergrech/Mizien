<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.name }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
{%- if pager and pager.prev %}
<link rel="prev" href="{{ pager.prev.path }}">
{%- endif %}
{%- if pager and pager.next %}
<link rel="next" href="{{ pager.next.path }}">
{%- endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}: updates to the checks" href="/feed.xml">
{%- if feedUrl %}
<link rel="alternate" type="application/atom+xml" title="{{ feedTitle }}" href="{{ feedUrl }}">
{%- endif %}
<meta name="theme-color" content="#0e2a1f">
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/tabs.css">
<script src="/assets/claimrefs.js" defer></script>
{%- if site.goatcounter %}
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <a class="brand" href="/">{% include "brand-mark.njk" %}<span>{{ site.name }}</span></a>
  {%- include "nav.njk" %}
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot">
  <p>{{ site.name }} is independent and not affiliated with any party, authority or institution. Checks that find a claim
     Not substantiated, Misleading or Contradicted stay drafts, pending right of reply, until the body concerned has had
     the chance to respond.</p>
  <p>Content is licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; site code is MIT.
     Source and data: <a href="{{ site.repo }}">github.com/leandergrech/Mizien</a>.
     <a href="/about/disclaimer/">What a check represents</a>.</p>
{%- if site.goatcounter %}
  <p>Visits are counted with <a href="https://www.goatcounter.com/">GoatCounter</a>: no cookies, no personal data, no tracking across sites.</p>
{%- endif %}
</footer>
</body>
</html>
