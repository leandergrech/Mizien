{#- The verdict strip for one body (site/_lib/who.js, whoSummary): one square per claim, the checked ones filled in verdict
    order from Contradicted to Supported, the rest hollow. The same strip on the index rows, the panel and the body page.
    Expects s (the summary) and big (true on the body page and in the panel: the key spells the verdict names). -#}
<div class="wm">
  <div class="wm-strip" role="img" aria-label="{% if s.checked %}Verdicts on {{ s.checked }} of {{ s.total }} claims: {% for v in s.counts %}{{ v.name }} {{ v.n }}{% if not loop.last %}, {% endif %}{% endfor %}{% if s.waiting %}; {{ s.waiting }} not yet checked{% endif %}{% else %}{{ s.total }} claim{% if s.total != 1 %}s{% endif %}, none checked yet{% endif %}">
    {%- for q in s.squares %}<i class="v-{{ q.slug }}" title="{{ q.name }}"></i>{% endfor %}
    {%- for i in range(0, s.waiting) %}<i class="is-open" title="Not yet checked"></i>{% endfor %}
  </div>
  <p class="wm-key">
    {%- for v in s.counts %}<span><i class="v-{{ v.slug }}"></i>{% if big %}{{ v.name }} {% endif %}<b>{{ v.n }}</b></span>{% endfor %}
    {%- if s.waiting %}<span><i class="is-open"></i>{% if big %}not yet checked {% endif %}<b>{{ s.waiting }}</b></span>{% endif %}
    {%- if s.few %}<span class="wm-few">{% if s.checked %}{{ s.checked }} of {{ s.fewMin }} checks: too few to summarise{% else %}no checks yet{% endif %}</span>{% endif %}
  </p>
</div>
{%- if s.targets and s.targets.length %}
<p class="wm-pledges">{% for p in s.targets %}<a class="pl-chip is-target" href="{{ p.path }}" style="--pl: {{ p.colour }}; --pl-ink: {{ p.ink }}" title="{{ p.id }} {{ p.title }}: an institutional target, {{ p.status }}, as of {{ p.as_of }}">{% glyph "pledge:" + p.status %}Target: {{ p.status }}{% if big %} <span>{{ p.id }}</span>{% endif %}</a>{% endfor %}</p>
{%- endif %}
{%- if s.pledges.length %}
<p class="wm-pledges">{% for p in s.pledges %}<a class="pl-chip" href="{{ p.path }}" style="--pl: {{ p.colour }}; --pl-ink: {{ p.ink }}" title="{{ p.id }} {{ p.title }}: {{ p.status }}, as of {{ p.as_of }}">{% glyph "pledge:" + p.status %}Pledge: {{ p.status }}{% if big %} <span>{{ p.id }}</span>{% endif %}</a>{% endfor %}</p>
{%- endif %}
