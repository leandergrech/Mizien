{#- The Timeline view of /explore/: every dated claim on a line of calendar days (assets/timeline.js, loaded when the
   view is first opened). The filter bar and the pinned tray are Explore's own. -#}
{%- set T = timelinePoints -%}
<p class="tlv-intro small">{{ T.points.length }} of {{ mizien.claims.length }} claims have a recorded date, shown on the day (or
  month, or year) the statement was made. Claims close together are clumped; zoom in and they separate. A dashed bar means
  only the month or year is known, so a claim is never placed more precisely than its source allows.</p>
<div class="tlv-card" id="tl" hidden>
  <div class="tlv-bar" role="toolbar" aria-label="Timeline zoom and position">
    <div class="tlv-levels" role="group" aria-label="Group claims by">
      <button type="button" data-level="year" aria-pressed="false">Years</button>
      <button type="button" data-level="month" aria-pressed="false">Months</button>
      <button type="button" data-level="week" aria-pressed="false">Weeks</button>
      <button type="button" data-level="day" aria-pressed="false">Days</button>
      <button type="button" data-level="hour" aria-pressed="false">Hours</button>
    </div>
    <div class="tlv-levels tlv-lanes" role="group" aria-label="Lanes">
      <button type="button" data-lanes="none" aria-pressed="true">One line</button>
      <button type="button" data-lanes="topic" aria-pressed="false">By topic</button>
      <button type="button" data-lanes="who" aria-pressed="false">By who said it</button>
      <button type="button" data-lanes="verdict" aria-pressed="false">By verdict</button>
    </div>
    <label class="tlv-check"><input type="checkbox" id="tl-checked"> Checked claims only</label>
    <div class="tlv-tools">
      <button type="button" class="tlv-btn" data-act="out" aria-label="Zoom out">−</button>
      <button type="button" class="tlv-btn" data-act="in" aria-label="Zoom in">+</button>
      <button type="button" class="tlv-btn tlv-wide" data-act="latest">Latest</button>
      <button type="button" class="tlv-btn tlv-wide" data-act="all">Show all</button>
    </div>
  </div>
  <p class="tlv-range small" id="tl-range" aria-live="off"></p>
  <div class="tlv-stage" id="tl-stage" tabindex="0" role="group"
    aria-label="Timeline of claims. Arrow keys move along the line; plus and minus zoom. The same claims are listed below as text."></div>
  <div class="tlv-over" id="tl-over" aria-hidden="true"></div>
  <p class="tlv-hint small">Drag to move. Pinch, or hold Ctrl and scroll, to zoom. Select a marker to read its claims.
    Lanes split the line by topic, by the kind of body that spoke, or by verdict, to show when claims of one kind cluster.</p>
  <div class="tlv-panel" id="tl-panel" aria-live="polite"><p class="small">Select a marker to see its claims.</p></div>
  <ul class="tlv-legend small" aria-label="Marker colours">
    {%- for v in mizien.verdicts %}<li><span class="tlv-key v-{{ v.slug }}"></span>{{ v.name }}</li>{% endfor %}
    <li><span class="tlv-key v-none"></span>Not yet checked</li>
    <li><span class="tlv-key tlv-key-pledge"></span>Pledge: a square, coloured by its label; a dot inside is the verdict on its facts</li>
    <li class="tlv-lkey">A numbered disc is a clump of claims. Its laurel has a leaf per checked claim, in its verdict colour,
      fading as the evidence review ages; a full laurel means every claim there is checked.</li>
  </ul>
</div>

<details class="tlv-list" id="tl-list" open>
  <summary>The same claims as a list, newest first</summary>
  <div id="tl-list-body">
  {%- for g in T.years %}
    <section><h2>{{ g.year }}</h2><ol class="tlv-ol">
    {%- for p in g.items %}
      <li><span class="tlv-d">{{ p.date | ukDate }}{% if p.time %}, {{ p.time }}{% endif %}</span>
        <a href="{{ p.path }}"><b>{{ p.id }}</b> {{ p.title }}</a>
        <span class="badge v-{{ p.v }}">{% if p.pledge %}Pledge: {% endif %}{{ p.label }}</span></li>
    {%- endfor %}
    </ol></section>
  {%- endfor %}
  {%- if T.undated.length %}
    <section><h2>No date recorded</h2><ol class="tlv-ol">
    {%- for p in T.undated %}
      <li><span class="tlv-d">undated</span><a href="{{ p.path }}"><b>{{ p.id }}</b> {{ p.title }}</a>
        <span class="badge v-{{ p.v }}">{% if p.pledge %}Pledge: {% endif %}{{ p.label }}</span></li>
    {%- endfor %}
    </ol></section>
  {%- endif %}
  </div>
</details>
<script type="application/json" id="tl-data">{{ { points: T.points, undated: T.undated, labels: T.labels } | dump | replace("<", "\\u003c") | safe }}</script>
