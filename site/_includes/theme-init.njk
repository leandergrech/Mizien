{#- Runs before the stylesheet so a reader who chose the light theme never sees the dark one flash. With no stored choice it
    follows the reader's system setting (prefers-color-scheme), dark where the browser cannot say.
    "?theme=light" or "?theme=dark" in the address shows that theme for this visit only (handy for sharing a link). -#}
<script>(function () { var t = window.matchMedia && matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark", q = /[?&]theme=(light|dark)\b/.exec(location.search);
  try { var s = localStorage.getItem("mizien.theme"); if (s === "light" || s === "dark") t = s; } catch (e) {}
  if (q) t = q[1]; document.documentElement.dataset.theme = t; })();</script>
