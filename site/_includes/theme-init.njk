{#- Runs before the stylesheet so a reader who chose the light theme never sees the dark one flash. Dark is the default; to
    follow the system setting instead, start from matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark".
    "?theme=light" or "?theme=dark" in the address shows that theme for this visit only (handy for sharing a link). -#}
<script>(function () { var t = "dark", q = /[?&]theme=(light|dark)\b/.exec(location.search);
  try { var s = localStorage.getItem("mizien.theme"); if (s === "light" || s === "dark") t = s; } catch (e) {}
  if (q) t = q[1]; document.documentElement.dataset.theme = t; })();</script>
