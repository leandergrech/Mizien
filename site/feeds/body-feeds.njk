---
pagination:
  data: mizien.bodies
  size: 1
  alias: body
permalink: "/bodies/{{ body.id }}/feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.name }}: claims by {{ body.name }}</title>
  <subtitle>Updates to the checks of claims by {{ body.name }}: new claims, verdicts, report versions and replies. A record, not a score.</subtitle>
  <id>{{ body.path | absoluteUrl }}</id>
  <link rel="self" type="application/atom+xml" href="{{ ('/bodies/' + body.id + '/feed.xml') | absoluteUrl }}"/>
  <link rel="alternate" type="text/html" href="{{ body.path | absoluteUrl }}"/>
  <updated>{% if body.updates.length %}{{ body.updates[0].iso }}T12:00:00Z{% else %}2026-10-02T12:00:00Z{% endif %}</updated>
  <author><name>{{ site.name }}</name></author>
  {%- set updates = body.updates %}
  {%- include "feed-entries.njk" %}
</feed>
