---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.name }}: updates to the checks</title>
  <subtitle>New claims, verdicts, report versions and replies. Drafts that find a claim Not substantiated, Misleading or Contradicted are pending right of reply.</subtitle>
  <id>{{ "/" | absoluteUrl }}</id>
  <link rel="self" type="application/atom+xml" href="{{ '/feed.xml' | absoluteUrl }}"/>
  <link rel="alternate" type="text/html" href="{{ '/' | absoluteUrl }}"/>
  <updated>{% if mizien.updates.length %}{{ mizien.updates[0].iso }}T12:00:00Z{% else %}2026-10-02T12:00:00Z{% endif %}</updated>
  <author><name>{{ site.name }}</name></author>
  {%- set updates = mizien.updates %}
  {%- include "feed-entries.njk" %}
</feed>
