---
layout: base.njk
title: Who said it
description: Every claim on Miżien is matched to the body or person who made it. Government, agencies, regulators, parties, NGOs, business and media as a tree, each with its claims and the verdicts so far.
permalink: /bodies/
styles: [lens.css, who.css]
---
{%- import "macros.njk" as m -%}
{#- One row of the tree: a body with its strip; a body with offices or people under it is a <details> whose summary is
    the row, so the tree opens and closes without JavaScript. The name is a link to the body page; assets/who-tree.js
    turns a click on it into a selection that fills the panel instead. -#}
{%- macro row(n, pledges, bodies) -%}
{%- set b = n.body -%}
{%- set s = b | whoSummary(pledges, bodies) -%}
{%- set inner -%}
  <span class="wt-frame{% if b.kind == 'person' %} is-person{% endif %}" aria-hidden="true">{% bodyglyph b %}</span>
  <span class="wt-text"><a class="wt-name" href="{{ b.path }}" data-id="{{ b.id }}">{{ b.name }}</a>
  {%- if b.role %} <span class="wt-role">{{ b.role }}</span>{% endif %}</span>
  <span class="wt-n">{{ s.total }}<span class="visually-hidden"> claims, {{ s.checked }} checked</span></span>
  <span class="wt-strip" aria-hidden="true">{% for q in s.squares %}<i class="v-{{ q.slug }}"></i>{% endfor %}{% for i in range(0, s.waiting) %}<i class="is-open"></i>{% endfor %}</span>
{%- endset -%}
{%- if n.children.length %}
<li class="wt-item has-kids" data-id="{{ b.id }}" data-search="{{ b.name }} {{ b.role or '' }} {{ (b.aliases or []) | join(' ') }}">
  <details class="wt-branch" data-id="{{ b.id }}">
    <summary class="wt-row"><span class="wt-caret" aria-hidden="true"></span>{{ inner | safe }}</summary>
    <ul class="wt-kids">{% for c in n.children %}{{ row(c, pledges, bodies) }}{% endfor %}</ul>
  </details>
</li>
{%- else %}
<li class="wt-item" data-id="{{ b.id }}" data-search="{{ b.name }} {{ b.role or '' }} {{ (b.aliases or []) | join(' ') }}">
  <div class="wt-row"><span class="wt-caret is-none" aria-hidden="true"></span>{{ inner | safe }}</div>
</li>
{%- endif %}
{%- endmacro -%}
{%- set tree = mizien.bodies | whoTree(mizien.body_types) -%}

<div class="who-stage" id="who-stage">
  <header class="who-head">
    <p class="kicker">Who said it</p>
    <h1>Bodies and people</h1>
    <p class="who-lead">{{ mizien.bodies | where("kind", "organisation") | length }} bodies and {{ mizien.bodies | where("kind", "person") | length }} people,
      each with the claims Miżien has matched to it. Pick one to see its claims and the verdicts so far. Every side is held to the same standard.</p>
  </header>

  <div class="who-cols">
    <section class="who-tree" aria-labelledby="h-tree">
      <h2 id="h-tree" class="visually-hidden">The register</h2>
      <p class="who-search">
        <label for="who-q" class="visually-hidden">Search a name, alias or role</label>
        <input id="who-q" type="search" placeholder="Search a name, alias or role" autocomplete="off" spellcheck="false" hidden>
        <span class="who-key-line"><i class="v-contradicted"></i><i class="v-misleading"></i><i class="v-not-substantiated"></i><i class="v-largely-supported"></i><i class="v-supported"></i><i class="is-open"></i>
          one square per claim, Contradicted to Supported, hollow when not yet checked · <a href="/methodology/connections/#summaries">how it is read</a></span>
      </p>
      <ul class="wt" id="who-tree">
        {%- for g in tree %}
        <li class="wt-kind" data-type="{{ g.type.id }}" style="--kind: {{ g.type.colour }}">
          <details class="wt-branch" open data-id="{{ g.type.id }}">
            <summary class="wt-row wt-kind-row"><span class="wt-caret" aria-hidden="true"></span>
              <span class="wt-frame is-kind" aria-hidden="true">{% glyph g.type.label %}</span>
              <span class="wt-text"><span class="wt-name">{{ g.type.label }}</span></span>
              <span class="wt-n">{{ g.n }} <span class="small">bod{% if g.n == 1 %}y{% else %}ies{% endif %}</span></span></summary>
            <ul class="wt-kids">{% for n in g.roots %}{{ row(n, mizien.pledges, mizien.bodies) }}{% endfor %}</ul>
          </details>
        </li>
        {%- endfor %}
      </ul>
      <p class="small who-foot">{% icon "pattern" %}<span><a href="/bodies/patterns/">Patterns by kind of body</a> · <a href="/pledges/#h-stack">Pledges, election by election</a> ·
        <a href="/explore/?group=speaker">the same register as a constellation in Explore</a> · <a href="/methodology/connections/#bodies">how claims are matched to bodies</a></span></p>
    </section>

    <aside class="who-panel-wrap" id="who-panel" aria-live="polite" aria-label="Selected body">
      <div class="wp wp-empty" id="wp-empty">
        <p class="wp-kicker">A record, not a score</p>
        <p>Pick a body or person on the left. Claims are chosen because they are public and can be checked, not to
          sample anyone's statements fairly, so a body with more claims here has simply been checked more often. Each
          verdict is about one statement as worded on its date.</p>
        <p class="small">Without JavaScript, each name opens the body's own page, which shows the same.</p>
      </div>
      <div class="wp" id="wp-body" hidden></div>
    </aside>
  </div>
</div>

<script type="application/json" id="who-data">{{ mizien.bodies | whoPanel(mizien.pledges) | safe }}</script>
<script src="/assets/tray.js" defer></script>
<script src="/assets/who-tree.js" defer></script>
