---
layout: base.njk
pagination:
  data: mizien.bodies
  size: 1
  alias: body
permalink: "/bodies/{{ body.id }}/"
styles: [lens.css, who.css]
---
{%- import "macros.njk" as m -%}
{%- set b = body -%}
{%- set withVerdict = b.claims | selectattr("label") | length -%}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol><li><a href="/">Home</a></li><li><a href="/bodies/">Who said it</a></li>
    {%- for a in b.ancestors %}<li><a href="{{ a.path }}">{{ a.name }}</a></li>{% endfor %}
    <li aria-current="page">{{ b.name }}</li></ol>
</nav>

<article class="page prose-page body-page">
  <header class="page-head">
    <p class="kicker">{% if b.kind == "person" %}Person · {% endif %}{{ b.type_label }}</p>
    <h1>{{ b.name }}</h1>
    {%- if b.role or (b.kind == "person" and b.parent) %}
    <p class="lead">{{ b.role }}{% if b.role and b.parent %}, {% endif %}{% if b.kind == "person" and b.parent %}speaking for <a href="{{ b.parent.path }}">{{ b.parent.name }}</a>{% endif %}</p>
    {%- endif %}
    {%- if b.note %}<p class="small">{{ b.note }}</p>{% endif %}
    {%- set s = b | whoSummary(mizien.pledges, mizien.bodies) %}
    <ul class="body-stats">
      <li><b>{{ s.total }}</b> claim{% if s.total != 1 %}s{% endif %} listed</li>
      <li><b>{{ s.checked }}</b> checked</li>
      {%- if s.pledges.length %}<li><b>{{ s.pledges.length }}</b> pledge{% if s.pledges.length != 1 %}s{% endif %}</li>{% endif %}
      <li><b>{{ b.links.length }}</b> linked bod{% if b.links.length == 1 %}y{% else %}ies{% endif %}</li>
    </ul>
    <div class="who-panel">
      {%- if b.kind == "person" %}
      <p class="small">Checks of claims by {{ b.name }}{% if b.parent %} count towards <a href="{{ b.parent.path }}">{{ b.parent.name }}</a>, the body they spoke for{% endif %}:
        Miżien summarises bodies, not people.</p>
      {%- if s.pledges.length %}<p class="wm-pledges">{% for p in s.pledges %}<a class="pl-chip" href="{{ p.path }}" style="--pl: {{ p.colour }}">{% glyph "pledge:" + p.status %}Pledge: {{ p.status }} <span>{{ p.id }}</span></a>{% endfor %}</p>{% endif %}
      {%- else %}
      {%- set big = true %}{% include "who-meter.njk" %}
      {%- endif %}
      <nav class="who-tools" aria-label="{{ b.name }} in the other views">
        <a href="/explore/?group=speaker&amp;sel=body:{{ b.id }}">{% icon "links" %}<span>In the claims web</span></a>
        <a href="/explore/?view=map&amp;who={{ b.type }}">{% icon "map" %}<span>{{ b.type_label }} on the map</span></a>
        <a href="/timeline/?who={{ b.type }}&amp;lanes=verdict">{% icon "clock" %}<span>{{ b.type_label }} on the timeline</span></a>
        <a href="#h-time">{% icon "clock" %}<span>Its statements over time</span></a>
        <button type="button" class="who-pin" data-ids="{% for c in b.claims %}{{ c.id }}{% if not loop.last %},{% endif %}{% endfor %}" hidden>Pin all {{ s.total }} claims</button>
        <span class="who-tray" id="who-tray"></span>
      </nav>
    </div>
  </header>

  <aside class="notice" aria-label="What this page shows">
    <p><strong>A record, not a score.</strong> This page lists the claims by {{ b.name }} that Miżien has picked up
      so far. Claims are chosen because they are public and can be checked, not to sample anyone's statements fairly,
      so the counts below say nothing about how accurate {{ "this person" if b.kind == "person" else "this body" }} is in
      general. Each verdict is about one statement as worded on its date. <a href="/methodology/connections/#bodies">How
      claims are matched to bodies</a>.</p>
  </aside>

  {%- if b.people.length or b.offices.length %}
  <section aria-labelledby="h-under">
    <h2 id="h-under">{% if b.offices.length %}Offices and people{% else %}People{% endif %}</h2>
    <p>Claims made by {% if b.offices.length %}these offices and people{% else %}these people{% endif %} on behalf of {{ b.name }} are counted here too.</p>
    <p class="conn-bodies">{% for x in b.offices %}{{ m.body(x) }} {% endfor %}{% for x in b.people %}{{ m.body(x) }} {% endfor %}</p>
  </section>
  {%- endif %}

  {%- set ps = mizien.pledges | pledgeStack(mizien.claims, s.pledges | pluck("id")) if s.pledges.length else null %}
  {%- if ps %}
  <section class="pstack-sec" aria-labelledby="h-pledges">
    <h2 id="h-pledges">Pledges, year by year</h2>
    <p>Each disk is a year in which {{ b.name }}{% if b.offices.length or b.people.length %} or its offices and people{% endif %}
      made pledges, the newest on top. Each dot is a pledge, coloured by its label, ringed in the colour of the verdict on
      its facts where those were checked; similar pledges line up and are joined across the years. The same view for
      every body is on <a href="/bodies/#h-pledges">Who said it</a>.</p>
    {%- include "pledge-stack.njk" %}
  </section>
  {%- endif %}

  <section aria-labelledby="h-claims">
    <h2 id="h-claims">Claims</h2>
    <div class="table-scroll">
    <table class="claims body-claims">
      <thead><tr><th scope="col">Claim</th><th scope="col">Topic</th><th scope="col">Date</th><th scope="col">Verdict</th></tr></thead>
      <tbody>
      {%- for c in b.claims %}
        <tr><td>{{ m.claim(c) }}{% set others = c.by | without("id", b.id) %}
          {%- if others.length %}<br><span class="small">by {% for x in others %}<a href="{{ x.path }}">{{ x.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</td>
          <td>{{ c.category }}</td><td>{{ c.date | ukDate }}</td>
          <td>{% if c.label %}<span class="badge v-{{ c.label_slug }}">{% if c.label_kind == "pledge" %}Pledge: {% endif %}{{ c.label }}</span>{% if c.status != "Published" %}<br><span class="small">draft</span>{% endif %}{% else %}<span class="small">not yet checked</span>{% endif %}</td></tr>
      {%- endfor %}
      </tbody>
    </table>
    </div>
  </section>

  {%- set T = b.time %}
  <section aria-labelledby="h-time">
    <h2 id="h-time">Statements over time</h2>
    <p>Each dot is one claim, placed on the date it was made and coloured by its verdict, with a row for each topic.
      Where {{ "this person" if b.kind == "person" else "this body" }} returned to a topic, the claims are listed below
      in date order, so you can see whether a position was repeated, changed or corrected. Read each check for the
      detail: the dots are not a score.</p>
    {%- if T.axis %}
    {%- include "timeline-chart.njk" %}
    {%- endif %}
    {%- if T.threads.length %}
    <h3>Topics {{ "they" if b.kind == "person" else "it" }} returned to</h3>
    <ul class="threads">
      {%- for th in T.threads %}
      <li><span class="thread-topic">{{ th.topic }}</span>
        <ol class="thread">{% for i in th.claims %}<li><span class="tl-date">{{ i.date }}</span> {{ m.claim(i) }}</li>{% endfor %}</ol></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if T.undated.length %}
    <p class="small">Not dated yet: {% for i in T.undated %}{{ m.claim(i, true) }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {%- endif %}
    <p class="feed-link">{% icon "feed" %}<a href="/bodies/{{ b.id }}/feed.xml">Follow these claims</a>
      <span class="small">(an Atom feed of new claims, verdicts and report updates; paste the link into a feed reader)</span></p>
    {%- if b.updates.length %}
    <details class="updates"><summary>Latest updates ({{ b.updates.length }})</summary>
      <ul>{% for u in b.updates | slice(0, 12) %}<li><span class="tl-date">{{ u.date }}</span> {{ m.claim(u.claim, true) }} {{ u.label }}{% if u.text %}: {{ u.text }}{% endif %}</li>{% endfor %}</ul>
    </details>
    {%- endif %}
  </section>

  <section aria-labelledby="h-about">
    <h2 id="h-about">What the claims are about</h2>
    <dl class="facts body-facts">
      <div><dt>Topics</dt><dd>{% for k, v in b.topics %}<span class="tally">{{ k }} <b>{{ v }}</b></span>{% endfor %}</dd></div>
      {%- if b.patterns | length %}
      <div><dt>Pattern tags</dt><dd>{% for k, v in b.patterns %}<span class="tally">{{ k }} <b>{{ v }}</b></span>{% endfor %}</dd></div>
      {%- endif %}
    </dl>
  </section>

  <section aria-labelledby="h-linked">
    <h2 id="h-linked">Linked bodies</h2>
    {%- if b.links.length %}
    <p>Bodies are linked when they are named in the same claim, or when their claims share a theme (a cause, a
      mechanism, a target or a way of presenting figures). A link says the claims are worth reading together; it does
      not say the bodies agree, disagree or act together.</p>
    {%- set shown = 8 %}
    <ul class="linked-bodies">
      {%- for l in b.links %}
      {%- if loop.index == shown + 1 %}
    </ul>
    <details class="more-bodies"><summary>Show {{ b.links.length - shown }} more linked bodies</summary>
    <ul class="linked-bodies">
      {%- endif %}
      <li>
        <p class="lb-name">{{ m.body(l) }}</p>
        {%- if l.named_with.length %}
        <p class="lb-why">Named in the same claim: {% for x in l.named_with %}{{ m.claim(x) }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
        {%- endif %}
        {%- for t in l.themes %}
        <p class="lb-why">Shares <span class="route-theme" style="--t: {{ (mizien.themes | findBy('id', t.id)).color }}">{{ t.name }}</span>:
          {% for pr in t.pairs %}{{ m.claim(pr[0], true) }} with {{ m.claim(pr[1], true) }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
        {%- endfor %}
      </li>
      {%- endfor %}
    </ul>
    {%- if b.links.length > shown %}</details>{% endif %}
    {%- else %}
    <p>No other body is linked yet: its claims share no theme with claims by others, and no claim names it with another body.</p>
    {%- endif %}
  </section>
</article>
<script src="/assets/tray.js" defer></script>
<script>
  // Pin all of this body's claims to the tray (assets/tray.js) shared with Explore, the timeline and claim pages.
  addEventListener("DOMContentLoaded", function () {
    var T = window.MizienTray, b = document.querySelector(".who-pin"), m = document.getElementById("who-tray"); if (!T || !b || !m) return;
    var ids = b.dataset.ids.split(",").filter(Boolean);
    function sync() { var all = ids.every(function (id) { return T.has(id); }); b.textContent = all ? "Unpin these " + ids.length + " claims" : "Pin all " + ids.length + " claims"; b.setAttribute("aria-pressed", all ? "true" : "false"); }
    b.addEventListener("click", function () { if (ids.every(function (id) { return T.has(id); })) ids.forEach(function (id) { T.remove(id); }); else T.add(ids); });
    T.init({ mount: m, url: false, onChange: sync }); b.hidden = false; sync();
  });
</script>
