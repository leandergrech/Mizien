---
permalink: /explore/
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Explore the claims · Miżien</title>
<meta name="description" content="Explore every claim Miżien has recorded: as a web of topics, bodies and links, on a map of Malta and Gozo, or on a timeline.">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ '/explore/' | absoluteUrl }}">
<meta name="theme-color" content="#0e2a1f">
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
<link rel="stylesheet" href="/assets/tabs.css">
<link rel="stylesheet" href="/assets/lens.css">
<style>
  :root {
    --bg: #0e2a1f; --bg2: #14452f; --ink: #eef3ef; --muted: #a9c2b1; --sage: #7fa88b;
    --amber: #e3a72f; --card: #f6f4ee; --slate: #2b3a42; --orange: #d9772b; --line: rgba(127,168,139,.22);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  html, body { height: 100%; }
  body { display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; overscroll-behavior: none;
         margin: 0; background: var(--bg); color: var(--ink);
         font: 16px/1.55 "Liberation Sans", Arial, Helvetica, sans-serif; }
  a { color: var(--amber); }
  header.top { flex: none; width: 100%; padding: 10px 20px 8px; display: flex; align-items: center;
               justify-content: space-between; gap: 10px 20px; flex-wrap: wrap; }
  header.top > .bar { display: flex; align-items: center; gap: 10px 20px; flex-wrap: wrap; min-width: 0; }
  .brand { text-decoration: none; color: var(--ink); }
  .brand { display: flex; align-items: center; gap: 13px; flex-wrap: nowrap; flex: none; }
  .brand-mark { width: 36px; height: 36px; flex: none; filter: drop-shadow(0 0 8px rgba(227,167,47,.22)); }
  .brand h1 { margin: 0; font: 700 26px/1.05 "Liberation Serif", Georgia, serif; letter-spacing: .5px; }
  .tag { color: var(--muted); font: italic 18px "Liberation Serif", Georgia, serif; margin: 6px 0 0; }
  .meaning { color: var(--sage); font-size: 13px; margin: 4px 0 0; }
  .stats { display: flex; gap: 22px; color: var(--muted); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .stats b { display: block; color: var(--ink); font: 700 20px/1.1 "Liberation Serif", Georgia, serif; letter-spacing: 0; text-transform: none; }

  /* ---------------------------------------------------------------- map, full width */
  #mapwrap { position: relative; flex: 1 1 auto; min-height: 0; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 58% 46%, #1d5a3f 0%, #133d2b 38%, #0b2419 78%);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  #mapwrap::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background: radial-gradient(circle at 15% 85%, rgba(227,167,47,.06), transparent 40%),
                radial-gradient(circle at 90% 10%, rgba(86,180,233,.06), transparent 35%); }
  #stage { position: relative; width: 100%; height: 100%; overflow: hidden; }
  #drawer { display: contents; }
  body > .xbar { flex: none; }
  #drawerbtn, #drawer .dhead { display: none; }
  canvas { width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  canvas.dragging { cursor: grabbing; }
  .tx { text-shadow: 0 1px 3px rgba(0,0,0,.65); }
  .kicker { font: 700 10.5px Arial, sans-serif; letter-spacing: .14em; color: var(--amber); margin: 0 0 7px; }

  /* left column: part of the background, no box */
  #legend { position: absolute; left: 26px; top: 22px; bottom: 76px; width: 236px; z-index: 2; display: flex;
            flex-direction: column; gap: 16px; pointer-events: none; }
  #legend > * { pointer-events: auto; }
  #legend > *, .moreopts > * { flex-shrink: 0; }
  @media (min-width: 901px) { #legend { overflow-y: auto; overflow-x: hidden; scrollbar-width: thin; scrollbar-color: rgba(127,168,139,.4) transparent; } }
  #groupby { display: flex; flex-wrap: wrap; gap: 6px; }
  #groupby button { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 999px;
    border: 1px solid rgba(207,226,212,.28); background: rgba(8,30,21,.35); color: var(--ink);
    font: 600 12px Arial, sans-serif; cursor: pointer; transition: all .2s; }
  #groupby button svg { width: 14px; height: 14px; }
  #groupby button:hover { border-color: var(--amber); }
  #groupby button[aria-pressed="true"] { background: var(--amber); border-color: var(--amber); color: #13301f; }
  #groupby button[aria-pressed="true"] svg path { stroke: #13301f; }
  #groups { display: flex; flex-direction: column; gap: 1px; }
#groups .gtools { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; }
  #groups .gtools .gtool { white-space: nowrap; width: auto; padding: 3px 10px; border-radius: 999px; border: 1px solid rgba(207,226,212,.3); background: none;
    color: var(--ink); font: 600 11.5px Arial, sans-serif; cursor: pointer; }
  #groups .gtools .gtool:hover:not(:disabled) { border-color: var(--amber); }
  #groups .gtools .gtool:disabled { opacity: .4; cursor: default; }
  #groups .gtools .gcount { color: var(--amber); font-size: 11.5px; }
  #groups .grow { display: flex; align-items: center; gap: 2px; }
  #groups .grow .gsel { flex: 1; min-width: 0; }
  #groups .grow .geye { flex: none; width: 32px; height: 28px; padding: 0; display: grid; place-items: center; border: 0; border-radius: 6px;
    background: none; cursor: pointer; }
  #groups .grow .geye svg { width: 17px; height: 17px; fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #groups .grow .geye:hover { background: rgba(127,168,139,.15); } #groups .grow .geye:hover svg { stroke: var(--amber); }
  #groups .grow.is-hidden .gname { text-decoration: line-through; color: var(--muted); }
  #groups .grow.is-hidden .sw { opacity: .35; }
  #groups .grow.is-hidden .geye svg { stroke: var(--amber); }
  #groups button { display: flex; align-items: center; gap: 9px; width: 100%; padding: 4px 6px 4px 0; border: 0;
    background: none; color: var(--ink); font: 13px Arial, sans-serif; text-align: left; cursor: pointer; border-radius: 6px; }
  #groups button:hover { background: rgba(127,168,139,.12); }
  #groups .sw { width: 22px; height: 22px; border-radius: 50%; flex: none; display: inline-flex; align-items: center;
    justify-content: center; box-shadow: 0 0 10px rgba(0,0,0,.35); }
  #groups .sw svg { width: 13px; height: 13px; }
  #groups .n { margin-left: auto; color: var(--muted); font-size: 11.5px; }
  #splitbox { margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(207,226,212,.16); }
  #splitbox .switch { padding-left: 2px; text-align: left; } #splitbox .switch:disabled { opacity: .45; cursor: default; }
  #splitbox .hint { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.4; max-width: 230px; }
  #groups .grow .gcar { flex: none; width: 24px; min-height: 24px; padding: 0; justify-content: center; color: var(--amber); font-size: 12px; background: none; }
  #groups .grow .gcar.none { visibility: hidden; }
  #groups .gsubs { margin: 0 0 4px 17px; padding-left: 10px; border-left: 1px solid rgba(207,226,212,.22); display: flex; flex-direction: column; }
  #groups .gsub { padding: 3px 6px 3px 2px; gap: 8px; font-size: 12.5px; }
  #groups .gsub.person { margin-left: 14px; width: calc(100% - 14px); color: var(--muted); }
  #groups .gsub .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  #groupnote { color: var(--muted); font-size: 12px; margin: 6px 0 0; max-width: 230px; }
  .keyrow { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11.5px; color: #d4e4d9; }
  .keyrow span { display: inline-flex; align-items: center; gap: 6px; }
  .vdot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .vdot.open { border: 1.5px dashed rgba(255,255,255,.75); }

  /* bottom bar: line filters */
  /* links control: a clear switch, a hint and theme chips (links are off by default) */
  #linkbar { position: absolute; left: 290px; bottom: 12px; max-width: min(820px, calc(100% - 520px)); z-index: 2; display: flex; align-items: center;
             gap: 8px 12px; flex-wrap: wrap; padding: 10px 14px; border-radius: 14px; background: rgba(6,24,16,.78);
             border: 1px solid rgba(207,226,212,.16); box-shadow: 0 8px 26px rgba(0,0,0,.3); backdrop-filter: blur(3px); }
  #linkbar .hint { flex: 1 1 260px; margin: 0; color: var(--muted); font: 12.5px/1.4 Arial, sans-serif; }
  #linkbar .themes { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 6px; }
  #linkbar .themes[hidden] { display: none; }
  #linkbar .themes-toggle { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(227,167,47,.55); background: none;
    color: var(--amber); font: 600 12.5px Arial, sans-serif; cursor: pointer; }
  #linkbar .themes-toggle:hover { background: rgba(227,167,47,.12); }
  #linkbar .themes button { display: inline-flex; align-items: center; gap: 7px; min-height: 30px; padding: 4px 11px; border-radius: 999px;
    border: 1px solid rgba(207,226,212,.3); background: rgba(8,30,21,.5); color: var(--ink);
    font: 12px Arial, sans-serif; cursor: pointer; transition: opacity .2s, border-color .2s; }
  #linkbar .themes button:hover { border-color: var(--amber); }
  #linkbar .themes button.off { color: var(--muted); border-style: dashed; }
  #linkbar .themes button.off .ln { opacity: .55; }
  #linkbar .themes .ln { width: 20px; height: 0; border-top: 3px solid; border-radius: 2px; }
  #linkbar .themes button.mini { color: var(--muted); }
  .switch { display: inline-flex; align-items: center; gap: 10px; padding: 4px 10px 4px 4px; border: 0; border-radius: 999px;
    background: none; color: var(--ink); cursor: pointer; text-align: left; font: 12px Arial, sans-serif; }
  .switch .track { position: relative; flex: none; width: 46px; height: 26px; border-radius: 999px; background: #3c5247;
    box-shadow: inset 0 0 0 1px rgba(207,226,212,.35); transition: background .2s; }
  .switch .knob { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #eef3ef;
    box-shadow: 0 1px 3px rgba(0,0,0,.4); transition: left .2s; }
  .switch.on .track { background: var(--amber); }
  .switch.on .knob { left: 23px; }
  .switch:hover .track { box-shadow: inset 0 0 0 1px var(--amber); }
  .switch-label { display: flex; flex-direction: column; line-height: 1.25; }
  .switch-label b { font: 700 14px Arial, sans-serif; }
  .switch-label .state { color: var(--muted); font-size: 12px; }
  .switch.small .track { width: 38px; height: 22px; } .switch.small .knob { width: 16px; height: 16px; }
  .switch.small.on .knob { left: 19px; } .switch.small .switch-label { font-size: 12.5px; }
  #arrange { display: flex; flex-wrap: wrap; gap: 6px; }
  #arrange button { padding: 5px 10px; border-radius: 999px; border: 1px solid rgba(207,226,212,.28); background: rgba(8,30,21,.35);
    color: var(--ink); font: 600 12px Arial, sans-serif; cursor: pointer; }
  #arrange button:hover { border-color: var(--amber); }
  #arrange button[aria-pressed="true"] { background: var(--amber); border-color: var(--amber); color: #13301f; }
  #arrangenote { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.4; }

  #controls { position: absolute; right: 22px; top: 18px; display: flex; gap: 4px; z-index: 3; }
  button.ctl { background: rgba(8,30,21,.45); color: var(--ink); border: 1px solid rgba(207,226,212,.22); border-radius: 999px;
               min-width: 36px; min-height: 36px; padding: 6px 12px; font: 12px Arial, sans-serif; cursor: pointer; }
  button.ctl:hover { border-color: var(--amber); }
  button:focus-visible, #panel a:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }
  #hint { position: absolute; right: 24px; bottom: 20px; max-width: 290px; text-align: right; font-size: 11.5px; color: var(--muted); pointer-events: none; z-index: 1; }
  .mobile-hint { display: none; }
  .dmenu { position: relative; }
  .dpop { position: absolute; right: 0; top: calc(100% + 6px); display: flex; flex-direction: column; gap: 4px; padding: 6px; min-width: 132px;
    border-radius: 14px; background: rgba(8,30,21,.94); border: 1px solid rgba(207,226,212,.22); box-shadow: 0 12px 30px rgba(0,0,0,.45); z-index: 7; }
  .dpop[hidden] { display: none; }
  .dpop .ctl { text-align: left; width: 100%; }
  #mapwrap.is-map #displaymenu { display: none; }
  .moreopts { display: contents; }
  .moreopts > summary { display: none; }
  .moreopts > div + div { margin-top: 16px; }
  #modeTitle { position: absolute; left: 50%; top: 20px; transform: translateX(-50%); z-index: 1; pointer-events: none;
    text-align: center; transition: opacity .4s; }
  #modeTitle .t { font: 700 22px "Liberation Serif", Georgia, serif; color: var(--ink); }
  #modeTitle .s { font-size: 12.5px; color: var(--muted); }

  #tip { position: absolute; display: none; pointer-events: none; max-width: 300px; padding: 6px 10px; border-radius: 8px; z-index: 5;
    background: rgba(246,244,238,.97); color: #14452f; font: 600 12px Arial, sans-serif; box-shadow: 0 6px 18px rgba(0,0,0,.4); }

  /* detail panel: header filled with the verdict (or group) colour, body tinted to match */
  #panel { --p-head: #14452f; --p-head2: #0e2a1f; --p-head-ink: #fff; --p-bg: #f6f4ee; --p-ink: #2b3a42; --p-soft: #e6efe8;
           --p-line: #d9e2db; --p-link: #14452f; --p-muted: #6b767c;
           /* docked as a right-hand column (like the controls on the left); the graph centres in the space between */
           position: absolute; right: 0; top: 0; bottom: 0; width: min(390px, 34vw); z-index: 4;
           overflow: auto; background: var(--p-bg); color: var(--p-ink); border-radius: 0; padding: 0;
           border-left: 1px solid rgba(207,226,212,.22); box-shadow: -12px 0 34px rgba(0,0,0,.32); display: none;
           transition: background .3s; }
  @media (min-width: 901px) {
    #mapwrap.panel-open #controls { right: calc(min(390px, 34vw) + 14px); }
    #mapwrap.panel-open #crumb, #mapwrap.panel-open #toast { left: calc(50% + 131px - min(390px, 34vw) / 2); }
    #modeTitle { left: 296px; transform: none; text-align: left; max-width: min(560px, calc(100% - 296px - 300px)); }
    #mapwrap.panel-open #modeTitle { max-width: calc(100% - 296px - min(390px, 34vw) - 300px); }
    #mapwrap.panel-open #modeTitle .s { display: none; }
    #mapwrap.panel-open #crumb { top: 124px; }
    #mapwrap.panel-open #toast { top: 170px; }
    #mapwrap.panel-open #linkbar { max-width: calc(100% - 314px - min(390px, 34vw)); }
    #mapwrap.panel-open #hint { right: calc(min(390px, 34vw) + 24px); }
  }
  #panel .phead { position: sticky; top: 0; z-index: 1; padding: 14px 92px 14px 18px; color: var(--p-head-ink);
    background: linear-gradient(135deg, var(--p-head) 0%, var(--p-head2) 100%); }
  #panel .phead::after { content: ""; position: absolute; left: 0; right: 0; bottom: -10px; height: 10px; pointer-events: none;
    background: linear-gradient(var(--p-bg), transparent); opacity: 0; }
  #panel h3 { margin: 2px 0 0; font: 700 19px/1.25 "Liberation Serif", Georgia, serif; color: var(--p-head-ink); }
  #panel .id { font: 700 10.5px Arial; letter-spacing: .12em; color: var(--p-head-ink); opacity: .78; }
  #panel .verdictline { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  #panel .vpill { display: inline-block; padding: 4px 11px; border-radius: 999px; font: 700 11.5px Arial; letter-spacing: .06em;
    text-transform: uppercase; background: rgba(255,255,255,.2); color: var(--p-head-ink); border: 1px solid rgba(255,255,255,.35); }
  #panel .vpill.dark { background: rgba(0,0,0,.12); border-color: rgba(0,0,0,.18); }
  #panel .openpage { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; padding: 7px 14px; border-radius: 999px;
    background: #fff; color: #14452f; font: 700 13px Arial, sans-serif; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
  #panel .openpage:hover { background: #f6f4ee; }
  #panel .openpage:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }
  #panel .hbtns { position: absolute; right: 8px; top: 8px; display: flex; gap: 2px; }
  #panel .hbtns button { min-width: 36px; min-height: 36px; border: 0; border-radius: 10px; background: rgba(255,255,255,.14);
    color: var(--p-head-ink); font: 700 16px Arial; cursor: pointer; }
  #panel .hbtns button:hover { background: rgba(255,255,255,.3); }
  #panel .hbtns .pbtn, #panel .grab { display: none; }
  #panel .pbody { padding: 12px 18px 18px; }
  #panel p { margin: 8px 0; font-size: 14px; }
  #panel .label { font: 700 10px Arial; letter-spacing: .12em; color: var(--p-muted); margin-top: 14px; padding-top: 8px;
    border-top: 1px solid var(--p-line); }
  .chip { display: inline-block; font: 700 11px Arial; padding: 3px 9px; border-radius: 999px; color: #fff; margin: 2px 4px 2px 0; }
  .chip.soft { background: #e6efe8; color: #14452f; }
  #panel .chip.soft { background: var(--p-soft); color: var(--p-ink); }
  #panel blockquote { margin: 4px 0 8px; padding: 8px 12px; border-left: 4px solid var(--p-head); background: rgba(255,255,255,.6);
    border-radius: 0 10px 10px 0; font: italic 15px/1.45 "Liberation Serif", Georgia, serif; color: var(--p-ink); }
  #panel p.small { font-size: 12px; color: var(--p-muted); margin: 4px 0; }
  #panel .links { display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
  #panel .lrow { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  #panel button.link { display: inline-flex; align-items: center; gap: 6px; text-align: left; background: none; border: 0;
    padding: 0; color: var(--p-link); cursor: pointer; font: 13px Arial; margin: 0; min-height: 24px; }
  #panel button.link:hover { text-decoration: underline; }
  #panel .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; box-shadow: 0 0 0 1.5px rgba(255,255,255,.8); }
  #panel button.tchip { background: #fff; border: 2px solid; border-radius: 999px; padding: 1px 8px; font: 700 10px Arial; color: #2b3a42; cursor: pointer; }
  #panel .acts { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
  #panel button.body-link { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; padding: 5px 0; border-bottom: 1px dashed var(--p-line); width: 100%; }
  #panel button.body-link b { font: 700 13px Arial; }
  #panel button.body-link .why { font: 12px/1.35 Arial; color: var(--p-muted); }
  #panel button.inline { background: none; border: 0; padding: 4px 0; min-height: 24px; font: 700 12px Arial; color: var(--p-link); text-decoration: underline; cursor: pointer; }
  #panel a.claimref { color: var(--p-link); font-weight: 700; text-decoration-style: dotted; text-underline-offset: 3px; }
  #panel p.note { margin-top: 14px; padding-top: 8px; border-top: 1px solid var(--p-line); }
  #panel .btn { display: inline-block; background: var(--p-link); color: #fff; border: 1px solid var(--p-link); border-radius: 8px;
    padding: 6px 10px; font: 700 12px Arial; text-decoration: none; cursor: pointer; }
  #panel .btn.ghost { background: #fff; color: var(--p-link); }
  #panel .btn:hover { border-color: #e3a72f; }
  .ctl[aria-pressed="true"] { background: var(--amber) !important; color: #13301f !important; border-color: var(--amber) !important; }
  .seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .seg button { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px;
    border: 1px solid rgba(207,226,212,.28); background: rgba(8,30,21,.35); color: var(--ink);
    font: 600 12px Arial, sans-serif; cursor: pointer; transition: all .2s; }
  .seg button svg { width: 14px; height: 14px; }
  .seg button:hover { border-color: var(--amber); }
  .seg button[aria-pressed="true"] { background: var(--amber); border-color: var(--amber); color: #13301f; }
  .seg button[aria-pressed="true"] svg path { stroke: #13301f; }
  #mapsearch input { width: 100%; box-sizing: border-box; padding: 7px 11px; border-radius: 999px; border: 1px solid rgba(207,226,212,.35);
    background: rgba(8,30,21,.55); color: var(--ink); font: 13px Arial, sans-serif; }
  #mapsearch input:focus { outline: 2px solid var(--amber); outline-offset: 1px; border-color: var(--amber); }
  #mapsearch input::placeholder { color: var(--muted); }
  #placeres { display: flex; flex-direction: column; gap: 1px; margin-top: 6px; }
  #placeres .hint { margin: 2px 0 2px; color: var(--muted); font-size: 12px; }
  #placeres button.place { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 28px; padding: 4px 8px; border: 0; border-radius: 6px;
    background: none; color: var(--ink); font: 13px Arial, sans-serif; text-align: left; cursor: pointer; }
  #placeres button.place:hover, #placeres button.place:focus-visible { background: rgba(127,168,139,.15); }
  #placeres .pname { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #placeres .kind { color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: .04em; }
  #placeres .n { min-width: 18px; text-align: right; color: var(--amber); font-size: 11.5px; font-weight: 700; }
  #treekey { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; max-width: 236px; display: flex; gap: 10px; align-items: flex-start; }
  #treekey b { color: var(--ink); font-weight: 600; }
  #treekey .gm-key { position: static; flex: none; width: 60px; height: 60px; }
  #mapwrap.is-map #hint { bottom: 30px; }
  #placeres button.unplaced { margin-top: 6px; border-top: 1px solid rgba(207,226,212,.14); border-radius: 0 0 6px 6px; color: var(--muted); }

  /* ---------------------------------------------------------------- map view (MapLibre) and its place medallions */
  #geomap { position: absolute; inset: 0; z-index: 0; background: #0c2c21; }
  #geomap[hidden] { display: none; }
  #mapwrap.is-map #modeTitle { pointer-events: none; padding: 6px 16px 7px; border-radius: 14px; background: rgba(8,30,21,.72); backdrop-filter: blur(4px); }
  @media (min-width: 901px) {
    #mapwrap.is-map #legend { bottom: auto; max-height: calc(100% - 44px); overflow: auto; padding: 14px 14px 16px; margin: -10px 0 0 -12px; border-radius: 16px;
      background: rgba(8,30,21,.84); border: 1px solid rgba(207,226,212,.14); box-shadow: 0 10px 30px rgba(0,0,0,.35); backdrop-filter: blur(4px); }
  }
  #mapwrap.is-map #modeTitle .t, #mapwrap.is-map #modeTitle .s { text-shadow: 0 1px 4px rgba(4,18,12,.95), 0 0 14px rgba(4,18,12,.8); }
  #mapwrap.is-map button.ctl { background: rgba(8,30,21,.88); }
  #mapwrap.is-map #hint { padding: 3px 10px; border-radius: 10px; background: rgba(8,30,21,.72); }
  .gm-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 2; }
  .gm-m { position: absolute; left: 0; top: 0; width: var(--s); height: var(--s); padding: 0; border: 0; background: none; cursor: pointer;
    pointer-events: auto; will-change: transform; -webkit-tap-highlight-color: transparent; }
  .gm-m.is-new .gm-art { animation: gm-pop .38s cubic-bezier(.2,.9,.3,1.3) both; }
  @keyframes gm-pop { from { transform: scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }
  .gm-art { position: absolute; inset: 0; display: block; transition: transform .15s; filter: drop-shadow(0 3px 6px rgba(0,0,0,.45)); }
  .gm-art svg { display: block; overflow: visible; }
  .gm-art .disc { fill: rgba(8,30,21,.93); stroke: #e3a72f; stroke-width: 1.8; }
  .gm-art .leaf { stroke: rgba(246,244,238,.9); stroke-width: 1; }
  .gm-art .count { fill: #f6e3b4; font: 700 13px Arial, sans-serif; text-anchor: middle; dominant-baseline: central; }
  .gm-art .emblem { fill: none; stroke: #f6e3b4; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .gm-m:hover .gm-art, .gm-m:focus-visible .gm-art { transform: scale(1.1); }
  .gm-m:focus-visible { outline: none; }
  .gm-m:focus-visible .disc, .gm-m.is-sel .disc { stroke: #fff; stroke-width: 2.6; }
  .gm-m.is-sel .gm-art { transform: scale(1.14); }
  .gm-m.is-sel .disc { fill: #14452f; }
  .gm-badge { position: absolute; left: calc(50% + var(--r) * .55); top: calc(50% - var(--r) - 6px); min-width: 18px; padding: 1px 5px; border-radius: 9px;
    background: #e3a72f; color: #13301f; font: 700 10.5px/14px Arial, sans-serif; text-align: center; pointer-events: none; }
  .gm-name { position: absolute; left: 50%; top: calc(50% + var(--r) + 4px); transform: translateX(-50%); max-width: 180px; padding: 2px 8px;
    border-radius: 999px; background: rgba(8,30,21,.82); border: 1px solid rgba(227,167,47,.45); color: #eef3ef; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; font: 700 11.5px/1.25 Arial, sans-serif; pointer-events: none; }
  .gm-m.is-sel .gm-name { border-color: #fff; }
  .gm-badge[hidden], .gm-name[hidden] { display: none; }
  #geomap .maplibregl-ctrl-attrib { background: rgba(8,30,21,.72); color: var(--muted); font-size: 11px; }
  #geomap .maplibregl-ctrl-attrib a { color: #cfe2d4; }
  #geomap .maplibregl-ctrl-attrib-button { filter: invert(1) hue-rotate(180deg); }
  #panel .vbar { display: flex; gap: 2px; height: 10px; margin: 10px 0 4px; border-radius: 5px; overflow: hidden; }
  #panel .vbar span { flex: 1; min-width: 3px; }
  @media (prefers-reduced-motion: reduce) { .gm-m.is-new .gm-art { animation: none; } .gm-art { transition: none; } }
  #toast { position: absolute; left: 50%; top: 110px; transform: translateX(-50%); z-index: 6; display: none; padding: 10px 16px;
    border-radius: 12px; background: #e3a72f; color: #13301f; font: 700 13px Arial, sans-serif; box-shadow: 0 10px 30px rgba(0,0,0,.45); }
  #crumb { position: absolute; left: 50%; top: 66px; transform: translateX(-50%); z-index: 3; display: none;
    padding: 6px 8px 6px 14px; border-radius: 999px; background: rgba(8,30,21,.7); border: 1px solid rgba(207,226,212,.25);
    font: 12.5px Arial, sans-serif; color: var(--ink); align-items: center; gap: 10px; backdrop-filter: blur(6px); }
  #crumb b { font-weight: 700; }
  #crumb button { border: 0; border-radius: 999px; padding: 4px 10px; background: var(--amber); color: #13301f; font: 700 11.5px Arial; cursor: pointer; }
  #panel .file-action { display: inline-flex; gap: 4px; align-items: stretch; }
  #panel .file-action .btn { border-radius: 8px 0 0 8px; }
  #panel .file-action .btn + .btn { border-radius: 0 8px 8px 0; margin-left: -5px; }

  #doc-viewer { width: min(1100px, calc(100vw - 32px)); height: min(88vh, 900px); max-width: none; max-height: none;
    padding: 0; border: 1px solid #7fa88b; border-radius: 14px; color: #2b3a42; background: #f6f4ee;
    box-shadow: 0 20px 70px rgba(0,0,0,.6); }
  #doc-viewer::backdrop { background: rgba(4,18,12,.82); backdrop-filter: blur(3px); }
  #doc-viewer .viewer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 54px; padding: 8px 12px 8px 18px; border-bottom: 1px solid #d9e2db; }
  #doc-viewer h2 { margin: 0; padding: 0; border: 0; font: 700 16px "Liberation Serif", Georgia, serif; color: #14452f; }
  #doc-viewer h2::after { display: none; }
  #doc-viewer .viewer-close { border: 0; border-radius: 8px; padding: 7px 11px; background: #14452f; color: white; cursor: pointer; }
  #doc-viewer iframe { display: block; width: 100%; height: calc(100% - 54px); border: 0; background: #fff; }
  #doc-viewer img { display: block; max-width: 100%; max-height: calc(100% - 54px); margin: 0 auto; object-fit: contain; }
  #doc-viewer [hidden] { display: none !important; }  /* the rules above would otherwise show the unused frame over the flyer */

  noscript { display: block; padding: 20px; color: var(--amber); }

  /* ---------------------------------------------------------------- narrow screens: key flows below the map */
  @media (max-width: 900px) {
    header.top { padding: max(8px, env(safe-area-inset-top)) 12px 6px; }
    header.top > .bar { width: 100%; flex-wrap: nowrap; }
    .brand { gap: 8px; } .brand-mark { width: 30px; height: 30px; } .brand h1 { font-size: 21px; }
    .stats { display: none; }
    /* the controls live in a drawer that slides up over the viewer */
    #drawer { display: block; position: absolute; left: 0; right: 0; bottom: 0; z-index: 9; max-height: 82%; overflow-y: auto;
      overscroll-behavior: contain; padding: 0 0 max(12px, env(safe-area-inset-bottom)); border-radius: 18px 18px 0 0;
      background: rgba(8,30,21,.98); border-top: 1px solid rgba(207,226,212,.2); box-shadow: 0 -18px 50px rgba(0,0,0,.55);
      transform: translateY(102%); visibility: hidden; transition: transform .25s ease, visibility 0s .25s; }
    #drawer.open { transform: none; visibility: visible; transition: transform .25s ease; }
    #drawer .dhead { display: flex; position: sticky; top: 0; z-index: 1; align-items: center; justify-content: space-between;
      padding: 12px 18px 8px; background: rgba(8,30,21,.98); }
    #drawer .dhead b { font: 700 16px "Liberation Serif", Georgia, serif; }
    #drawerbtn { display: inline-block; }
    #legend, #linkbar { position: static; width: auto; padding: 14px 18px 4px; }
    #legend { gap: 14px; }
    #groups { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; }
    #linkbar { margin: 4px 12px 18px; padding: 12px 14px; border-radius: 12px; left: auto; right: auto; bottom: auto; max-width: none; }
    .home-tabs { flex: 1 1 auto; min-width: 0; margin: 0; }
    .home-tabs .tabs { min-width: 0; max-width: 100%; }
    #controls { right: 10px; top: 10px; }
    #modeTitle { top: 14px; left: 18px; transform: none; text-align: left; }
    #modeTitle .t { font-size: 18px; }
    #modeTitle .s { display: none; }
    .moreopts { display: block; border-top: 1px solid rgba(207,226,212,.16); padding-top: 4px; }
    .moreopts > summary { display: list-item; cursor: pointer; padding: 10px 0; color: var(--amber); font: 700 13px Arial, sans-serif; }
    .moreopts[open] > div { margin-top: 14px; }
    #panel { left: 8px; right: 8px; top: auto; bottom: max(8px, env(safe-area-inset-bottom)); width: auto; max-height: 62%;
             border-radius: 16px; border-left: 0; box-shadow: 0 22px 60px rgba(0,0,0,.55); }
    #panel.fit { max-height: 62%; }
    #panel .hbtns .pbtn { display: inline-block; }
    #panel { transition: transform .2s ease, background .3s; }
    #panel .phead { touch-action: none; padding-top: 18px; }
    #panel .grab { display: block; position: absolute; top: 6px; left: 50%; width: 40px; height: 4px; margin-left: -20px;
      border-radius: 2px; background: currentColor; opacity: .55; }
    #panel.peek { max-height: none; overflow: hidden; }
    #panel.peek .pbody, #panel.peek .verdictline { display: none; }
    #panel.peek .phead { cursor: pointer; padding-bottom: 12px; }
    #panel.peek h3 { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #crumb { top: 86px; max-width: calc(100% - 16px); white-space: nowrap; font-size: 11.5px; gap: 6px; }
    #controls { left: 8px; right: 8px; top: 8px; flex-wrap: nowrap; overflow-x: auto; justify-content: flex-end; scrollbar-width: none; }
    #controls::-webkit-scrollbar { display: none; }
    button.ctl { min-height: 32px; min-width: 32px; padding: 5px 10px; font-size: 11.5px; flex: none; }
    #modeTitle { top: 50px; }
    #toast { top: 96px; max-width: calc(100% - 24px); }
    .desktop-hint { display: none; }
    .mobile-hint { display: inline; }
    #hint { left: 12px; right: 12px; bottom: 10px; text-align: center; max-width: none; }
  }
  @media (max-width: 480px) { #groups { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  /* ---------------------------------------------------------------- list view and accessible verdict chips */
  .skip { position: absolute; left: 12px; top: -60px; z-index: 10; padding: 8px 14px; border-radius: 8px;
    background: var(--amber); color: #13301f; font-weight: 700; text-decoration: none; }
  .skip:focus { top: 12px; }
  .home-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0; min-width: 0; }
  .chip.v-supported { background: #2e7d4f; color: #fff; }
  .chip.v-largely-supported { background: #8db36b; color: #13301f; }
  .chip.v-not-substantiated { background: #d9772b; color: #13301f; }
  .chip.v-misleading { background: #b5483a; color: #fff; }
  .chip.v-contradicted { background: #8e2f25; color: #fff; }
  .chip.v-none { background: #5d7468; color: #fff; }
  #claims a { color: var(--ink); }
</style>
<script>(function(){var t=new URLSearchParams(location.search).get("previewTheme");document.documentElement.dataset.mapTheme=["botanical","field-atlas","civic-clarity"].indexOf(t)>=0?t:"botanical";})();</script>
</head>
<body>
<a class="skip" href="/claims/">Skip the viewer: list of all claims</a>
<header class="top">
  <div class="bar">
    <a class="brand" href="/" aria-label="Miżien home"><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="28" fill="none" stroke="#7fa88b" stroke-width="2"/><path d="M32 11V52M13 21L51 24M32 17L13 21M32 17L51 24M13 21L9 37M13 21L19 37M8 37H22L19 41Q15 44 11 41ZM51 24L47 40M51 24L57 40M44 40H58L55 44Q51 47 47 44ZM23 53H41" fill="none" stroke="#eef3ef" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="17" r="4" fill="#e3a72f"/></svg><h1>Miżien</h1></a>
    <div class="home-tabs">{% include "nav.njk" %}</div>
  </div>
  <div class="stats" id="stats" aria-live="polite"></div>
</header>
<div class="xbar">
  <div id="viewby" class="xviews" role="group" aria-label="View"></div>
  <div id="lensbar"></div>
</div>

<div id="mapwrap">
  <div id="stage" role="region" aria-label="Interactive 3D map of fact-checked claims" aria-describedby="hint">
    <canvas id="map" tabindex="0" aria-label="Claims map; arrow keys move, plus and minus zoom, 0 fits"></canvas>
    <div id="modeTitle" class="tx"><div class="t"></div><div class="s"></div></div>
    <div id="crumb" role="status"></div>
    <div id="controls">
      <div class="dmenu" id="displaymenu">
        <button class="ctl" id="displaybtn" type="button" aria-expanded="false" aria-controls="displaypop" title="Labels, lens and motion">Display ▾</button>
        <div class="dpop" id="displaypop" role="group" aria-label="Display options" hidden>
          <button class="ctl" id="labelmode" type="button" aria-pressed="false" title="Show claim names instead of codes (N)">Names</button>
          <button class="ctl" id="lenstoggle" type="button" aria-pressed="false" title="Magnifying lens at the centre (L)">Lens</button>
          <button class="ctl" id="texttoggle" type="button" aria-pressed="false" title="Hide all text on the map (T)">Hide text</button>
          <button class="ctl" id="spin" type="button" aria-label="Pause map rotation">Pause</button>
        </div>
      </div>
      <button class="ctl" id="drawerbtn" type="button" aria-expanded="false" aria-controls="drawer">Views &amp; filters</button>
      <button class="ctl" id="zoomout" type="button" aria-label="Zoom out" title="Zoom out">−</button>
      <button class="ctl" id="zoomin" type="button" aria-label="Zoom in" title="Zoom in">+</button>
      <button class="ctl" id="reset" type="button" aria-label="Reset view: centre and zoom" title="Centre and fit (0)">Fit</button>
    </div>
    <div id="hint" class="tx"><span class="desktop-hint"></span><span class="mobile-hint"></span></div>
    <div id="toast" role="status"></div>
    <div id="tip" role="tooltip"></div>
    <div id="panel" aria-live="polite"></div>
  </div>
  <div id="drawer" role="dialog" aria-label="Views and filters">
  <div class="dhead"><b>Views &amp; filters</b><button class="ctl" id="drawerclose" type="button" aria-label="Close views and filters">Done</button></div>
  <div id="legend" class="tx">
    <div id="mapsearch" hidden><p class="kicker"><label for="placeq">FIND CLAIMS BY PLACE</label></p>
      <input id="placeq" type="search" placeholder="A town or site, e.g. Marsa" autocomplete="off" spellcheck="false">
      <div id="placeres" aria-live="polite"></div>
      <p id="treekey"><span class="gm-art gm-key" aria-hidden="true"></span>
        <span>Each medallion is a <b>place</b>: the number is its claims, and each <b>leaf</b> is a checked claim, coloured by its verdict. Places close together share a medallion until you zoom in. Press a place to list its claims.</span></p></div>
    <div id="groupbox"><p class="kicker">GROUP CLAIMS BY</p><div id="groupby" role="group" aria-label="Group claims by"></div><div id="splitbox"></div></div>
    <details id="moreopts" class="moreopts"><summary>More options: arrange, show or hide groups, colours</summary>
    <div id="arrangebox"><p class="kicker">ARRANGE GROUPS BY</p><div id="arrange" role="group" aria-label="Arrange groups by"></div><p id="arrangenote"></p></div>
    <div id="groupsbox"><p class="kicker" id="groupsTitle">GROUPS</p><div id="groups"></div><p id="groupnote"></p></div>
    <div><p class="kicker">CLAIM COLOUR · VERDICT</p><div class="keyrow" id="vkey"></div></div>
    </details>
  </div>
  <div id="linkbar" class="tx" role="group" aria-label="Show or hide lines"></div>
  </div>
</div>
<dialog id="doc-viewer" aria-labelledby="viewer-title">
  <div class="viewer-head"><h2 id="viewer-title">Claim document</h2><button class="viewer-close" type="button">Close</button></div>
  <iframe title="Claim document viewer" hidden></iframe><img alt="Claim flyer" hidden>
</dialog>
<noscript>The interactive map needs JavaScript. Every claim is listed on the <a href="/claims/">all claims page</a>.</noscript>

<script src="/assets/lens.js" defer></script>
<script src="/assets/map/map.js" defer></script>
<script src="/assets/claimrefs.js" defer></script>
{%- if site.umami.websiteId %}
<script defer src="{{ site.umami.scriptUrl }}" data-website-id="{{ site.umami.websiteId }}"></script>
{%- endif %}
</body>
</html>
